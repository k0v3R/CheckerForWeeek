{
  "manifest_version": 3,
  "name": "Checker for Weeek",
  "description": "Неофициальное расширение: счётчик и список непрочитанных уведомлений в Weeek (app.weeek.net).",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Checker for Weeek",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["alarms", "storage", "cookies", "offscreen", "notifications"],
  "host_permissions": ["https://api.weeek.net/*", "https://app.weeek.net/*"]
}
